{
  "name": "luana",
  "version": "1.1.0",
  "author": "Zyad Almasabi <zyadalmasabi@gmail.com>",
  "license": "MIT",
  "description": "Luana — desktop Grok agent (chat + coding folders)",
  "homepage": "https://github.com/zyadalmasabi/luana",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyadalmasabi/luana.git"
  },
  "main": "electron/main.js",
  "bin": {
    "luda": "bin/luda"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node electron/dev-launch.js\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "cli": "node electron/cli.js",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.luda.editor",
    "productName": "Luda",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Luda.exe"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.474.0",
    "monaco-editor": "^0.52.2",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  }
}
